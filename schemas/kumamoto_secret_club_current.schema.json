{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clubpyramid-sys.github.io/kumamoto-ai-public-data/schemas/kumamoto_secret_club_current.schema.json",
  "title": "Kumamoto Secret Club current event feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "generated_at", "status", "current_event", "recent_items"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rss_url", "site_url", "blog_url"],
      "properties": {
        "name": {"const": "熊本秘密クラブ 開催情報BLOG"},
        "rss_url": {"const": "https://kumamotosecretclub.jp/blog2/rss.xml"},
        "site_url": {"const": "https://kumamotosecretclub.jp/"},
        "blog_url": {"const": "https://kumamotosecretclub.jp/blog2/"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "status": {"enum": ["ok", "no_current_event"]},
    "current_event": {"oneOf": [{"$ref": "#/$defs/event"}, {"type": "null"}]},
    "recent_items": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/event"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"current_event": {"$ref": "#/$defs/event"}}, "required": ["current_event"]}
    },
    {
      "if": {"properties": {"status": {"const": "no_current_event"}}},
      "then": {
        "properties": {"current_event": {"type": "null"}, "recent_items": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "nullableDateTime": {"oneOf": [{"type": "string", "format": "date-time", "maxLength": 35}, {"type": "null"}]},
    "nullableDate": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
    "nullableTime": {"oneOf": [{"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}, {"type": "null"}]},
    "nullableArea": {
      "oneOf": [
        {"enum": ["熊本市中心部", "熊本市郊外", "熊本市内", "下通周辺", "西銀座通り周辺", "上通周辺"]},
        {"type": "null"}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "published_at", "updated_at", "event_date", "event_time", "area", "summary", "status", "url", "source_type"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "published_at": {"$ref": "#/$defs/nullableDateTime"},
        "updated_at": {"$ref": "#/$defs/nullableDateTime"},
        "event_date": {"$ref": "#/$defs/nullableDate"},
        "event_time": {"$ref": "#/$defs/nullableTime"},
        "area": {"$ref": "#/$defs/nullableArea"},
        "summary": {"type": "string", "maxLength": 260},
        "status": {"enum": ["scheduled", "accepting", "updated", "cancelled"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://kumamotosecretclub\\.jp/blog2/"},
        "source_type": {"const": "rss"}
      }
    }
  }
}
